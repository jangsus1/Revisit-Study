{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.4.4/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Cluster Flow: Perceived Number in Grouped Node-Link Diagrams",
    "version": "pilot",
    "authors": [
      "The reVISit Team"
    ],
    "date": "2026-09-04",
    "description": "A staircased two-interval forced-choice study measuring how Gestalt grouping cues in flow diagrams change the perceived number of items. Each participant runs one cue x density cell.",
    "organizations": [
      "University of Utah",
      "WPI"
    ]
  },
  "uiConfig": {
    "contactEmail": "minsuk@gatech.edu",
    "helpTextPath": "cluster-flow-staircase/assets/help.md",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "withProgressBar": false,
    "withSidebar": false,
    "showTitleBar": false,
    "nextOnEnter": true,
    "autoDownloadStudy": false,
    "numSequences": 120,
    "urlParticipantIdParam": "PROLIFIC_PID",
    "studyEndMsg": "Thank you for completing the study. Your responses have been recorded."
  },
  "studyRules": {
    "display": {
      "minWidth": 1280,
      "minHeight": 800,
      "blockedMessage": "This study needs a window of at least 1280 x 800 pixels. Please maximise your browser window or use a larger screen."
    },
    "devices": {
      "allowed": [
        "desktop"
      ],
      "blockedMessage": "This study can only be taken on a desktop or laptop computer."
    },
    "inputs": {
      "allowed": [
        "mouse"
      ],
      "blockedMessage": "This study requires a keyboard and a mouse or trackpad."
    }
  },
  "importedLibraries": [
    "demographics"
  ],
  "baseComponents": {
    "trial-base": {
      "type": "react-component",
      "path": "cluster-flow-staircase/assets/TrialRunner.tsx",
      "nextOnEnter": true,
      "response": [
        {
          "id": "trial",
          "prompt": "Trial",
          "location": "belowStimulus",
          "type": "reactive"
        },
        {
          "id": "trialData",
          "prompt": "Trial data",
          "location": "belowStimulus",
          "type": "reactive",
          "hidden": true,
          "required": false
        }
      ]
    }
  },
  "components": {
    "introduction": {
      "type": "react-component",
      "path": "cluster-flow-staircase/assets/InfoPage.tsx",
      "parameters": {
        "page": "introduction"
      },
      "response": []
    },
    "consent": {
      "type": "markdown",
      "path": "cluster-flow-staircase/assets/consent.md",
      "response": [
        {
          "id": "accept",
          "prompt": "Do you consent to take part in this study?",
          "location": "belowStimulus",
          "type": "radio",
          "options": [
            "Decline",
            "Accept"
          ],
          "requiredValue": "Accept"
        }
      ],
      "nextButtonText": "Agree"
    },
    "setup": {
      "type": "react-component",
      "path": "cluster-flow-staircase/assets/SetupCheck.tsx",
      "nextOnEnter": true,
      "response": [
        {
          "id": "setup",
          "prompt": "Display check",
          "location": "belowStimulus",
          "type": "reactive",
          "hidden": true
        }
      ]
    },
    "instructions": {
      "type": "react-component",
      "path": "cluster-flow-staircase/assets/InfoPage.tsx",
      "parameters": {
        "page": "instructions"
      },
      "response": []
    },
    "practice-intro": {
      "type": "react-component",
      "path": "cluster-flow-staircase/assets/InfoPage.tsx",
      "parameters": {
        "page": "practice"
      },
      "response": []
    },
    "block-intro": {
      "type": "react-component",
      "path": "cluster-flow-staircase/assets/InfoPage.tsx",
      "parameters": {
        "page": "main"
      },
      "response": []
    },
    "rest": {
      "type": "react-component",
      "path": "cluster-flow-staircase/assets/InfoPage.tsx",
      "parameters": {
        "page": "rest"
      },
      "response": []
    },
    "trial": {
      "baseComponent": "trial-base"
    },
    "practice-trial": {
      "baseComponent": "trial-base",
      "provideFeedback": true,
      "trainingAttempts": 1,
      "allowFailedTraining": true
    }
  },
  "sequence": {
    "order": "fixed",
    "components": [
      "introduction",
      "consent",
      "setup",
      "instructions",
      {
        "order": "latinSquare",
        "numSamples": 1,
        "components": [
          {
            "order": "fixed",
            "components": [
              "practice-intro",
              {
                "id": "practice-proximity-sparse",
                "order": "dynamic",
                "functionPath": "cluster-flow-staircase/assets/practiceBlock.tsx",
                "parameters": {
                  "cue": "proximity",
                  "density": "sparse"
                }
              },
              "block-intro",
              {
                "id": "cell-proximity-sparse",
                "order": "dynamic",
                "functionPath": "cluster-flow-staircase/assets/staircaseBlock.tsx",
                "parameters": {
                  "cellId": "cell-proximity-sparse",
                  "cue": "proximity",
                  "density": "sparse"
                }
              }
            ]
          },
          {
            "order": "fixed",
            "components": [
              "practice-intro",
              {
                "id": "practice-proximity-dense",
