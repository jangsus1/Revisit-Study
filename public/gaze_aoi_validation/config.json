{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.4.4/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Webcam gaze accuracy at areas of interest (chart-free validation)",
    "version": "pilot",
    "authors": [
      "Minsuk Chang"
    ],
    "date": "2026-11-15",
    "description": "Letter targets on an empty chart frame; models fitted on grid, grid + AOI and grid + control calibration dots compared on the same frames",
    "organizations": [
      "Georgia Institute of Technology"
    ]
  },
  "uiConfig": {
    "contactEmail": "minsuk@gatech.edu",
    "helpTextPath": "scatterplot_gaze/assets/help.md",
    "logoPath": "revisitAssets/gt_logo.png",
    "withProgressBar": true,
    "autoDownloadStudy": false,
    "withSidebar": false,
    "urlParticipantIdParam": "PROLIFIC_PID",
    "studyEndMsg": "**Thank you for completing the study. You may click this link and return to Prolific**: [https://app.prolific.com/submissions/complete?cc=C1OCRYTV](https://app.prolific.com/submissions/complete?cc=C1OCRYTV)",
    "showTitle": false,
    "nextButtonDisabledUntilValid": true
  },
  "studyRules": {
    "devices": {
      "allowed": [
        "desktop"
      ],
      "blockedMessage": "This study requires a desktop or laptop computer with a webcam."
    },
    "inputs": {
      "allowed": [
        "mouse"
      ],
      "blockedMessage": "This study requires a mouse or trackpad."
    },
    "display": {
      "minWidth": 900,
      "minHeight": 550,
      "blockedMessage": "Please make your browser window larger (full screen works best)."
    },
    "browsers": {
      "allowed": [
        {
          "name": "chrome",
          "minVersion": 110
        },
        {
          "name": "edge",
          "minVersion": 110
        },
        {
          "name": "firefox",
          "minVersion": 115
        }
      ],
      "blockedMessage": "Please use a recent version of Chrome, Edge or Firefox. Safari is not supported for the eye-tracking task."
    }
  },
