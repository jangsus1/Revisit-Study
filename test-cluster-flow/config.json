{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.4.4/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Test: Cluster Flow Staircase",
    "version": "pilot",
    "authors": [
      "The reVISit Team"
    ],
    "date": "2026-09-04",
    "description": "A shortened cluster-flow staircase study used by the Playwright end-to-end test.",
    "organizations": [
      "University of Utah",
      "WPI"
    ]
  },
  "uiConfig": {
    "contactEmail": "minsuk@gatech.edu",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "withProgressBar": false,
    "withSidebar": false,
    "showTitleBar": false,
    "nextOnEnter": true,
    "autoDownloadStudy": false,
    "numSequences": 1
  },
  "baseComponents": {
    "trial-base": {
      "type": "react-component",
      "path": "cluster-flow-staircase/assets/TrialRunner.tsx",
      "nextOnEnter": true,
      "response": [
        {
          "id": "trial",
          "prompt": "Trial",
          "location": "belowStimulus",
          "type": "reactive"
        },
        {
          "id": "trialData",
          "prompt": "Trial data",
          "location": "belowStimulus",
          "type": "reactive",
          "hidden": true,
          "required": false
        }
      ]
    }
  },
  "components": {
    "introduction": {
      "type": "react-component",
      "path": "cluster-flow-staircase/assets/InfoPage.tsx",
      "parameters": {
        "page": "introduction",
        "readingSeconds": 1
      },
      "response": []
    },
    "instructions": {
      "type": "react-component",
      "path": "cluster-flow-staircase/assets/InfoPage.tsx",
      "parameters": {
        "page": "instructions",
        "readingSeconds": 1
      },
      "response": []
    },
    "examples": {
      "type": "react-component",
      "path": "cluster-flow-staircase/assets/ExamplePage.tsx",
      "response": [],
      "parameters": {
        "readingSeconds": 1
      }
    },
    "practice-intro": {
      "type": "react-component",
      "path": "cluster-flow-staircase/assets/InfoPage.tsx",
      "parameters": {
        "page": "practice",
        "readingSeconds": 1
      },
      "response": []
    },
    "block-intro": {
      "type": "react-component",
      "path": "cluster-flow-staircase/assets/InfoPage.tsx",
      "parameters": {
        "page": "main",
        "readingSeconds": 1
      },
      "response": []
    },
    "rest": {
      "type": "react-component",
      "path": "cluster-flow-staircase/assets/InfoPage.tsx",
      "parameters": {
        "page": "rest"
      },
      "response": []
    },
    "setup": {
      "type": "react-component",
      "path": "cluster-flow-staircase/assets/SetupCheck.tsx",
      "nextOnEnter": true,
      "response": [
        {
          "id": "setup",
          "prompt": "Display check",
          "location": "belowStimulus",
          "type": "reactive",
          "hidden": true
        }
      ],
      "parameters": {
        "calibrationIntervals": 4,
        "refreshSamples": 20
      }
    },
    "trial": {
      "baseComponent": "trial-base"
    },
    "practice-trial": {
      "baseComponent": "trial-base"
    }
  },
  "sequence": {
    "order": "fixed",
    "components": [
      "introduction",
      "setup",
      "instructions",
      {
        "order": "latinSquare",
        "numSamples": 1,
        "components": [
          {
            "order": "fixed",
            "components": [
              "examples",
              "practice-intro",
              {
                "id": "practice-color-sparse",
                "order": "dynamic",
                "functionPath": "cluster-flow-staircase/assets/practiceBlock.tsx",
                "parameters": {
                  "cue": "color",
                  "density": "sparse"
                }
              },
              "block-intro",
              {
                "id": "cell-color-sparse",
                "order": "dynamic",
                "functionPath": "cluster-flow-staircase/assets/staircaseBlock.tsx",
                "parameters": {
                  "cellId": "cell-color-sparse",
                  "cue": "color",
                  "density": "sparse",
                  "maxReversals": 1,
                  "maxTrials": 3,
                  "catchEvery": 2,
                  "restEvery": 2
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
